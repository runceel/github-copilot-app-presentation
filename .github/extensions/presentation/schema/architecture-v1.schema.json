{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runceel/github-copilot-app-presentation/main/.github/extensions/presentation/schema/architecture-v1.schema.json",
  "title": "Architecture DSL v1",
  "description": "presentation canvas 拡張機能の ```architecture ブロックが受け付ける制約付き JSON DSL (v1) の形状定義。このスキーマは形状 (shape) のみを検証する必要条件であり、十分条件ではありません。参照整合性・id の一意性・平坦化後の要素数上限・レイアウト適合といった意味 (semantic) 検証は renderer/architecture.mjs の parseArchitecture が担当します。詳細は同じディレクトリの README.md を参照してください。",
  "type": "object",
  "additionalProperties": false,
  "required": ["elements"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "エディター補完・検証のためのスキーマ参照。実行時には無視されます。"
    },
    "version": {
      "const": 1,
      "description": "DSL の文法バージョン。v1 では 1 のみ。省略時も 1 として扱われます。"
    },
    "canvas": {
      "$ref": "#/$defs/canvas",
      "description": "図の論理座標系サイズ。省略時は 1600x900。"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "図のアクセシブルな名前。省略時は \"Architecture diagram\"。"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "図の補足説明。スクリーンリーダー向けの説明として使われます。"
    },
    "elements": {
      "type": "array",
      "maxItems": 200,
      "description": "最上位の要素配列。図全体で要素は 200 個まで、コネクターは 100 本までですが、その合計判定は parseArchitecture が行います。",
      "items": { "$ref": "#/$defs/elementFixedL0" }
    }
  },
  "$defs": {
    "themeToken": {
      "enum": [
        "accent",
        "accentStrong",
        "accentSoft",
        "accentLine",
        "surface",
        "fg",
        "muted",
        "body",
        "border",
        "bg"
      ],
      "description": "テーマに追従する色トークン。テーマを切り替えても図が破綻しないため、リテラル色より推奨されます。"
    },
    "literalColor": {
      "type": "string",
      "pattern": "^(?:#[0-9a-fA-F]{3,8}|[Bb][Ll][Aa][Cc][Kk]|[Ww][Hh][Ii][Tt][Ee]|[Tt][Rr][Aa][Nn][Ss][Pp][Aa][Rr][Ee][Nn][Tt]|[Nn][Oo][Nn][Ee])$",
      "description": "リテラル色。16 進表記 (#rgb 〜 #rrggbbaa) と black / white / transparent / none のみ。rgb() や名前付き色 (red など) は使えません。"
    },
    "color": {
      "anyOf": [
        { "$ref": "#/$defs/themeToken" },
        { "$ref": "#/$defs/literalColor" }
      ],
      "description": "テーマトークン名、または限定されたリテラル色。任意の CSS 色は受け付けません。"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
      "description": "英字で始まり、英数字と '.', '_', '-' のみを含む 1〜64 文字の識別子。"
    },
    "coordinate": {
      "type": "number",
      "minimum": -4000,
      "maximum": 4000,
      "description": "canvas 座標系上の座標。親 group からの相対値です。"
    },
    "extent": {
      "type": "number",
      "minimum": 1,
      "maximum": 4000,
      "description": "幅または高さ。親 group が layout を持つ場合、実際の上限はセルサイズに依存し parseArchitecture が判定します。"
    },
    "zIndex": {
      "type": "number",
      "minimum": -100,
      "maximum": 100,
      "description": "重ね順。既定値は group が -50、connector が -10、node が 0。"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 320, "maximum": 4000 },
        "height": { "type": "number", "minimum": 180, "maximum": 4000 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "外観の上書き。省略した項目は要素種別ごとの既定値が使われます。",
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/color" },
        "textColor": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0.5, "maximum": 20 },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 160 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "dash": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^$|^\\d+(?:\\.\\d+)?(?:[ ,]+\\d+(?:\\.\\d+)?)*$",
          "description": "破線パターン。空白かカンマ区切りの非負数のみ (例: \"12 8\")。空文字は破線なしを意味します。"
        },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 200 }
      }
    },
    "layoutObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["row", "column", "grid"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 240 },
        "rowGap": { "type": "number", "minimum": 0, "maximum": 240 },
        "columnGap": { "type": "number", "minimum": 0, "maximum": 240 },
        "padding": { "type": "number", "minimum": 0, "maximum": 400 },
        "columns": {
          "type": "number",
          "minimum": 1,
          "maximum": 12,
          "description": "grid の列数。小数は切り捨てられます。row / column では無視されます。"
        }
      }
    },
    "layout": {
      "anyOf": [
        {
          "enum": ["row", "column", "grid"],
          "description": "文字列ショートハンド。gap 36 / padding 54 / columns 3 が既定値になります。"
        },
        { "$ref": "#/$defs/layoutObject" }
      ],
      "description": "子要素の自動配置。指定すると子の x / y / width / height は自動計算され、記述しても x / y は無視されます。"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" }
      }
    },
    "nodeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "node" },
        "id": { "$ref": "#/$defs/identifier" },
        "shape": { "enum": ["rect", "rounded-rect", "ellipse"] },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "width": { "$ref": "#/$defs/extent" },
        "height": { "$ref": "#/$defs/extent" },
        "text": { "type": "string", "maxLength": 500 },
        "icon": { "enum": ["cloud", "database", "api", "user", "server"] },
        "ariaLabel": { "type": "string", "maxLength": 300 },
        "z": { "$ref": "#/$defs/zIndex" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "nodeFixed": {
      "description": "layout を持たない親の直下に置かれる node。位置とサイズが必須です。",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "$ref": "#/$defs/boxRequired" }
      ]
    },
    "nodeFlow": {
      "description": "layout を持つ group の直下に置かれる node。位置とサイズは自動計算されます。",
      "$ref": "#/$defs/nodeBase"
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to"],
      "properties": {
        "type": { "const": "connector" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "fromPort": { "enum": ["auto", "top", "right", "bottom", "left"] },
        "toPort": { "enum": ["auto", "top", "right", "bottom", "left"] },
        "label": { "type": "string", "maxLength": 200 },
        "ariaLabel": { "type": "string", "maxLength": 300 },
        "routing": { "enum": ["straight", "orthogonal", "polyline"] },
        "points": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/point" },
          "description": "routing が polyline のときだけ指定できる中継点。"
        },
        "arrow": { "type": "boolean" },
        "lane": {
          "type": "number",
          "minimum": -12,
          "maximum": 12,
          "description": "並走するコネクターの分離レーン。小数は切り捨てられます。"
        },
        "z": { "$ref": "#/$defs/zIndex" },
        "style": { "$ref": "#/$defs/style" }
      },
      "if": {
        "type": "object",
        "required": ["routing"],
        "properties": { "routing": { "const": "polyline" } }
      },
      "else": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "maxItems": 0,
            "description": "points は routing が polyline のときのみ指定できます。"
          }
        }
      }
    },
    "groupBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "group" },
        "id": { "$ref": "#/$defs/identifier" },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "width": { "$ref": "#/$defs/extent" },
        "height": { "$ref": "#/$defs/extent" },
        "title": { "type": "string", "maxLength": 200 },
        "ariaLabel": { "type": "string", "maxLength": 300 },
        "layout": { "$ref": "#/$defs/layout" },
        "z": { "$ref": "#/$defs/zIndex" },
        "style": { "$ref": "#/$defs/style" },
        "children": { "type": "array", "maxItems": 200 }
      }
    },
    "groupChildrenL1": {
      "if": { "type": "object", "required": ["layout"] },
      "then": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFlowL1" } }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFixedL1" } }
        }
      }
    },
    "groupChildrenL2": {
      "if": { "type": "object", "required": ["layout"] },
      "then": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFlowL2" } }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFixedL2" } }
        }
      }
    },
    "groupChildrenL3": {
      "if": { "type": "object", "required": ["layout"] },
      "then": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFlowL3" } }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFixedL3" } }
        }
      }
    },
    "groupChildrenL4": {
      "if": { "type": "object", "required": ["layout"] },
      "then": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFlowL4" } }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "children": { "type": "array", "items": { "$ref": "#/$defs/elementFixedL4" } }
        }
      }
    },
    "boxRequired": {
      "description": "layout を持たない親の直下では x / y / width / height が必須です。",
      "type": "object",
      "required": ["x", "y", "width", "height"]
    },
    "groupFixedL0": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/boxRequired" },
        { "$ref": "#/$defs/groupChildrenL1" }
      ]
    },
    "groupFlowL0": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/groupChildrenL1" }
      ]
    },
    "groupFixedL1": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/boxRequired" },
        { "$ref": "#/$defs/groupChildrenL2" }
      ]
    },
    "groupFlowL1": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/groupChildrenL2" }
      ]
    },
    "groupFixedL2": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/boxRequired" },
        { "$ref": "#/$defs/groupChildrenL3" }
      ]
    },
    "groupFlowL2": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/groupChildrenL3" }
      ]
    },
    "groupFixedL3": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/boxRequired" },
        { "$ref": "#/$defs/groupChildrenL4" }
      ]
    },
    "groupFlowL3": {
      "allOf": [
        { "$ref": "#/$defs/groupBase" },
        { "$ref": "#/$defs/groupChildrenL4" }
      ]
    },
    "elementFixedL0": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["node", "group", "connector"],
          "description": "要素の種別。"
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFixed" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFixedL0" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFixedL1": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["node", "group", "connector"] } },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFixed" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFixedL1" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFlowL1": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["node", "group", "connector"] } },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFlow" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFlowL1" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFixedL2": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["node", "group", "connector"] } },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFixed" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFixedL2" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFlowL2": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["node", "group", "connector"] } },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFlow" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFlowL2" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFixedL3": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["node", "group", "connector"] } },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFixed" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFixedL3" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFlowL3": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["node", "group", "connector"] } },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFlow" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "group" } } },
          "then": { "$ref": "#/$defs/groupFlowL3" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFixedL4": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["node", "connector"],
          "description": "入れ子は 4 段までのため、この深さに group は置けません。"
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFixed" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    },
    "elementFlowL4": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["node", "connector"],
          "description": "入れ子は 4 段までのため、この深さに group は置けません。"
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "node" } } },
          "then": { "$ref": "#/$defs/nodeFlow" }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "connector" } } },
          "then": { "$ref": "#/$defs/connector" }
        }
      ]
    }
  }
}
