{
  "name": "markdstage-tests",
  "private": true,
  "type": "module",
  "description": "Test and CI infrastructure for the MarkdStage canvas Extension (not included in distributions)",
  "scripts": {
    "test": "npm run test:vendor && npm run test:schema && npm run test:unit && npm run test:cli && npm run test:editing && npm run test:visual && npm run test:a11y && npm run test:perf && npm run test:pdf",
    "test:vendor": "cd .github/extensions/markdstage && node scripts/vendor-assets.mjs verify vendor vendor/vendor-assets.lock.json",
    "test:schema": "node --test test/schema/architecture-schema.test.mjs test/schema/architecture-edit-schema.test.mjs test/schema/theme-metadata-schema.test.mjs",
    "test:unit": "cd .github/extensions/markdstage && node --test",
    "test:cli": "cd packages/markdstage-cli && npm test",
    "skills": "cd packages/markdstage-cli && npm run skills",
    "skills:check": "cd packages/markdstage-cli && npm run skills:check",
    "test:visual": "playwright test --project=visual",
    "test:editing": "playwright test --project=editing",
    "test:pdf": "playwright test --project=pdf",
    "test:a11y": "playwright test --project=a11y",
    "test:perf": "playwright test --project=perf",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:docker": "node test/scripts/playwright-docker.mjs",
    "test:visual:update:linux": "node test/scripts/playwright-docker.mjs --project=visual --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "axe-core": "4.13.0"
  }
}
