  <ItemGroup>
    <Content Include="..\..\..\..\test\fixtures\markdown-deck-corpus.json">
      <Link>Fixtures\markdown-deck-corpus.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

