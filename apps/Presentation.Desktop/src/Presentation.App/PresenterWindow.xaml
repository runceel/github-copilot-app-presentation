<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PresentationApp.PresenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PresentationApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="発表画面"
    mc:Ignorable="d">

    <!--
        No TitleBar element and ExtendsContentIntoTitleBar is left at its default (false), so
        Windows draws the standard system title bar with the usual move/resize/caption-button
        behavior. The WebView2 fills the entire client area below it.
    -->
    <Grid
        x:Name="WebViewHost"
        AutomationProperties.AutomationId="PresenterWebViewHost"
        Background="Black"
        IsTabStop="True"
        KeyDown="OnHostKeyDown">
        <WebView2
            x:Name="PresenterWebView"
            AutomationProperties.AutomationId="PresenterWebView"
            DefaultBackgroundColor="Black"
            IsTabStop="True"
            KeyDown="OnHostKeyDown" />
    </Grid>
</Window>
